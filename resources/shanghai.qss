
// Original deep indigo "night" palette - same family/feel as the well-known night themes,
// but intentionally offset by a few units per channel so no value is an exact match.
#define RQT_BORDER_COLOR                    rgb(43, 47, 70)
#define RQT_BORDER_STYLE                    1px solid RQT_BORDER_COLOR

#define RQT_DEFAULT_BACKGROUND_COLOR        rgb(24, 26, 40)
#define RQT_INPUT_BACKGROUND_COLOR          rgb(20, 21, 32)
#define RQT_DISABLED_INPUT_BACKGROUND_COLOR rgb(23, 25, 38)
#define RQT_ACTIVE_BACKGROUND_COLOR         rgb(38, 43, 63)
#define RQT_HOVER_BACKGROUND_COLOR          rgb(116, 158, 244)
#define RQT_SELECTED_BACKGROUND_COLOR       rgb(42, 55, 92)
#define RQT_RENDER_BACKGROUND_COLOR         rgb(20, 21, 32)

#define RQT_DEFAULT_TEXT_COLOR              rgb(198, 206, 242)
#define RQT_DISABLED_TEXT_COLOR             rgb(90, 99, 142)
#define RQT_INFO_TEXT_COLOR                 rgb(114, 124, 165)
#define RQT_HOVER_TEXT_COLOR                rgb(24, 26, 40)
#define RQT_SELECTED_TEXT_COLOR             rgb(198, 206, 242)

#ifdef _WIN32
	#define FIXED_WIDTH_FONT_FAMILY         "Consolas"
#endif
#ifdef __APPLE__
	#define FIXED_WIDTH_FONT_FAMILY         "Monaco"
#endif
#ifdef __linux__
	#define FIXED_WIDTH_FONT_FAMILY         "Courier New"
#endif
